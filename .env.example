# ============================================================
# 渡口 Ferry · 环境变量示例
# ------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env（.env 已被 .gitignore 排除，不会入库）
#        cp .env.example .env
#   2. 按需修改取值，随后在启动后端前导入环境变量：
#        set -a && source .env && set +a
#        cd backend && mvn spring-boot:run
#   3. 本文件中的取值全部为示例值，请勿写入真实口令或密钥。
# ============================================================

# ---- 数据库连接（对应 application.properties 中的 spring.datasource.*）----
# 数据库主机，默认 localhost
DB_HOST=localhost
# 数据库端口，默认 3306
DB_PORT=3306
# 数据库名，默认 ferry；需与 schema.sql / data.sql 的执行目标库一致
DB_NAME=ferry
# 数据库用户名，默认 root
DB_USER=root
# 数据库口令，默认空；请填入你自己本地实例的口令，不要提交到仓库
DB_PASSWORD=

# ---- JWT ----
# 令牌签名密钥。示例值仅供本地开发，生产环境请替换为随机长串，
# 例如用 openssl rand -base64 48 生成
JWT_SECRET=ferry-dev-only-secret-change-in-production
# 令牌有效期（秒），默认 86400，即 24 小时
JWT_EXPIRE=86400
