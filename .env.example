# ============================================================
# 渡口 Ferry · 环境变量示例
# ------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env（.env 已被 .gitignore 排除，不会入库）
#        cp .env.example .env
#   2. 按需修改取值，随后在启动后端前导入环境变量：
#        set -a && source .env && set +a
#        cd backend && mvn spring-boot:run
#   3. 本文件中的取值全部为示例值，请勿写入真实口令或密钥。
# ============================================================

# ---- 数据库连接（对应 application.properties 中的 spring.datasource.*）----
# 数据库主机，默认 localhost
DB_HOST=localhost
# 数据库端口，默认 3306
DB_PORT=3306
# 数据库名，默认 ferry；需与 schema.sql / data.sql 的执行目标库一致
DB_NAME=ferry
# 数据库用户名，默认 root
DB_USER=root
# 数据库口令，默认空；请填入你自己本地实例的口令，不要提交到仓库
DB_PASSWORD=

# ---- JWT ----
# 令牌签名密钥。示例值仅供本地开发，生产环境请替换为随机长串，
# 例如用 openssl rand -base64 48 生成
JWT_SECRET=ferry-dev-only-secret-change-in-production
# 令牌有效期（秒），默认 86400，即 24 小时
JWT_EXPIRE=86400

# ============================================================
# Docker Compose 专用（docker compose up 时自动读取）
# ------------------------------------------------------------
# 下面几个变量只在「方式二：Docker Compose」下生效，
# 本地手动启动（方式一）可以完全忽略。
#
# 口径说明，避免踩坑：
#   * 两套数据库口令完全独立，互不影响：
#       DB_PASSWORD    —— 「方式一」本地启动时，连你宿主机 MySQL 的口令
#       MYSQL_PASSWORD —— 「方式二」Docker 启动时，容器内业务账号 ferry 的口令
#     分开之后，本机 root 口令不会被复制进容器，公开的演示登录口令
#     也不会顺带变成数据库口令。
#   * DB_USER 在 Docker 模式下不生效（compose 里固定用 ferry）。
#     上面的 DB_USER=root 是给「方式一」连你宿主机 MySQL 用的。
#     不要试图把 Docker 的账号改成 root —— mysql 官方镜像会直接拒绝启动。
# ============================================================

# 容器内 MySQL 的 root 口令。root 仅供容器内运维与健康检查使用，
# 后端不会用 root 连库。建议与 MYSQL_PASSWORD 设为不同值。
MYSQL_ROOT_PASSWORD=
# 容器内业务账号 ferry 的口令，同时供后端连库使用。
# 生成方式：openssl rand -base64 24
MYSQL_PASSWORD=

# 前端对外端口，默认 8088（避开宿主机常被占用的 8080）
FRONTEND_PORT=8088

# ---- 向量库（Redis Stack）----
# 以下两项仅供容器内互连使用，docker-compose 里已写死为 redis / 6379，
# 一般不需要改；本地手动启动（方式一）时若没装 Redis，可以保持默认并忽略。
# 注意：必须是 Redis Stack（含 RediSearch 模块），普通 Redis 无法做向量检索。
REDIS_HOST=redis
REDIS_PORT=6379
# Redis 口令，默认空（当前 compose 未开启 requirepass）
REDIS_PASSWORD=

# ---- 大模型（硅基流动 SiliconFlow）----
# 后端从环境变量读取；留空时应用仍能启动，仅智能助教问答不可用
SILICONFLOW_API_KEY=

# ---- AI 大模型（S2 智能助教）----
# 硅基流动 API Key：https://cloud.siliconflow.cn/ → 控制台 → API 密钥
# 使用免费模型前需完成实名认证，否则调用会失败
# 当前选型（均免费）：
#   向量  BAAI/bge-m3            1024 维，中文 RAG 主流
#   对话  Qwen/Qwen3-8B          按检索资料作答
#   重排  BAAI/bge-reranker-v2-m3 二次排序
SILICONFLOW_API_KEY=

